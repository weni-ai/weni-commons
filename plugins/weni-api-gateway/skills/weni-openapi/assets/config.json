{
  "openapi_version": "3.0.0",
  "servers": [
    {
      "url": "https://cx.vtex.com/api/v1",
      "description": "Weni CX API gateway."
    }
  ],
  "inventory": {
    "command": "python manage.py api_gateway_inventory --out .openapi/inventory.json",
    "path": ".openapi/inventory.json",
    "supported_versions": [1]
  },
  "output": {
    "directory": "docs/openapi",
    "filename_template": "{slug}.openapi.json",
    "publish_repository": "openapi-schemas",
    "publish_filename_template": "VTEX - {title}.json"
  },
  "spectral": {
    "ruleset_repository": "openapi-schemas",
    "ruleset_file": ".spectral.yml",
    "custom_functions": ["definedNotExample", "noChainedRefsInComponents"]
  },
